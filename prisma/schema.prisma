generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Session {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  expiresAt DateTime
}

/// Singleton tracking failed login attempts against the single shared app
/// password, for the rate-limit lockout (see lib/auth/rate-limit.ts and
/// ADR-0004). id is always LOGIN_LOCKOUT_ID. failedCount resets to 0 on any
/// successful login.
model LoginLockout {
  id          String    @id
  failedCount Int       @default(0)
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
}

/// Singleton for the three Settings toggles (#66). id is always
/// APP_SETTINGS_ID. emptyAppMode's actual zero-everywhere behavior lands in
/// #70; weeklyReviewPrompt's delivery-rule wiring lands with Nudges (#69) —
/// this ticket only needs the toggle UI + persistence for both.
model AppSettings {
  id                 String   @id
  reduceMotion       Boolean  @default(false)
  emptyAppMode       Boolean  @default(false)
  weeklyReviewPrompt Boolean  @default(true)
  /// The Nudges page's Delivery rules card (#79) — read by
  /// lib/nudges/data.ts's getDeliveryRules(). Defaulting true matches
  /// the behavior these three had before this card existed (#69 hardcoded
  /// them on).
  morningBrief       Boolean  @default(true)
  eveningCheckIn     Boolean  @default(true)
  streakWarnings     Boolean  @default(true)
  updatedAt          DateTime @updatedAt
}

/// A top-level life domain (Health, Finances, ...). id is a stable slug,
/// not a cuid, so seeding can upsert by a human-readable, idempotent key.
/// color propagates to every Area/Goal/Habit/Task under it (see lib/colors.ts)
/// — a subtle accent, never a strongly saturated fill.
model Pillar {
  id        String     @id
  name      String
  color     String?
  northStar String?
  /// Shown on the Pillars card per the handoff — not user-editable (per
  /// #49's grilling Q13/#58 scope, a new Pillar is just its row + accent
  /// color, no description-authoring flow).
  desc      String?
  /// A percentage (independent per Pillar, no enforced sum-to-100 — see
  /// #49's grilling Q13). Feeds Insights' Attention Balance module (#63).
  intendedTimeShare Int?
  areas     Area[]
  thoughts  Thought[]
  tasks     Task[]
  goals     LifeGoal[]
  habits    Habit[]
  systems   System[]
  visuals   Visual[]
  /// Ordered `{type, visible}[]` over this page's section types (#160,
  /// ADR-0016) — Json rather than a join table, same "read/written as one
  /// blob, never queried per-section" reasoning as WeeklyReviewSession's
  /// verdicts. Null means "no config yet" — resolveSectionOrder in
  /// lib/pillar-page/sections.ts then shows every section this page
  /// builds, visible, in the order its own `sections` array lists them
  /// (see e.g. app/(protected)/(shell)/[pillarId]/page.tsx) — same as
  /// before this field existed.
  sectionConfig Json?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

/// A sub-topic within a Pillar (e.g. Sleep within Health). id is a stable
/// slug for the same idempotent-seeding reason as Pillar.id.
model Area {
  id               String            @id
  pillarId         String
  pillar           Pillar            @relation(fields: [pillarId], references: [id])
  name             String
  currentState     String?
  northStar        String?
  sortOrder        Int
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  habits           Habit[]
  /// Legacy one-off-action records, superseded by Task.areaId — kept only so
  /// existing rows aren't orphaned; no app code writes here anymore (see
  /// Task's schema comment for where this data actually lives now).
  actionGoals      ActionGoal[]
  goals            LifeGoal[]
  tasks            Task[]
  painMobilityLogs PainMobilityLog[]
  thoughts         Thought[]
  systems          System[]
  visuals          Visual[]
  /// Same shape/reasoning as Pillar.sectionConfig (#160, ADR-0016) —
  /// independent per Area, since a Pillar and its Areas can each show a
  /// different subset/order of section types.
  sectionConfig    Json?

  @@index([pillarId])
}

/// Kept only as the historical record of what `frequency` used to mean —
/// still stored on old CheckIn-adjacent code paths' types, but Habit itself
/// now uses the richer `scheduleType` below.
enum HabitFrequency {
  DAILY
  WEEKLY
}

enum CheckInLevel {
  FULL
  MINIMUM
}

/// New Habits default to PAUSED — opt-in, not opt-out (the same principle
/// the old `active: false` default encoded).
enum HabitStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

/// DAILY/WEEKDAYS/WEEKLY/EVERY_N_DAYS/EVERY_N_WEEKS/MONTHLY don't need every
/// field below — see lib/habits/schedule.ts's isScheduledForDate for which
/// fields each type actually reads. CUSTOM stores only scheduleCustomText
/// and never auto-generates an occurrence (same documented limitation as
/// Task.repeatRule's CUSTOM — see lib/tasks/recurrence.ts).
enum HabitScheduleType {
  DAILY
  WEEKDAYS
  SELECTED_WEEKDAYS
  WEEKLY
  EVERY_N_DAYS
  EVERY_N_WEEKS
  MONTHLY
  CUSTOM
  PER_WEEK
}

/// A recurring behaviour. Restricted to one Pillar (areaId is the optional
/// "primary Area" within it); Goal links live in HabitGoal, not here, since
/// a Habit can support several Goals within its Pillar. There is no separate
/// "Habit occurrence" table — whether a Habit occurs on a given date is
/// computed from its schedule (lib/habits/schedule.ts), and completing an
/// occurrence is exactly the existing CheckIn row for that date. That's the
/// whole "occurrence" concept: computed presence + a completion record,
/// never a duplicated Task.
model Habit {
  id   String @id @default(cuid())
  name String

  pillarId String
  pillar   Pillar  @relation(fields: [pillarId], references: [id])
  areaId   String?
  area     Area?   @relation(fields: [areaId], references: [id])

  status HabitStatus @default(PAUSED)

  scheduleType       HabitScheduleType @default(DAILY)
  scheduleWeekdays   Int[]             @default([])
  scheduleIntervalN  Int?
  scheduleAnchorDate DateTime?         @db.Date
  scheduleCustomText String?
  /// Only meaningful for PER_WEEK — "N times a week", a count, not an
  /// interval (see scheduleIntervalN, which means "every N days/weeks").
  /// Kept as a separate field so the two meanings can never be conflated.
  scheduleTargetCount Int?

  /// Superseded by scheduleType, kept non-null for old rows' sake until a
  /// future cleanup migration; no app code reads this anymore.
  frequency HabitFrequency @default(DAILY)

  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  checkIns  CheckIn[]
  goals     HabitGoal[]
  systems   SystemHabit[]

  @@index([areaId])
  @@index([pillarId])
}

/// Many-to-many Habit<->LifeGoal, with at most one isPrimary=true row per
/// habit (enforced in lib/habits/actions.ts, not the schema — matching the
/// rest of this app's relaxed-constraint style). All linked goals are
/// expected to share the habit's pillarId (enforced the same way).
model HabitGoal {
  habitId   String
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  goalId    String
  goal      LifeGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  isPrimary Boolean  @default(false)

  @@id([habitId, goalId])
  @@index([goalId])
}

/// One row per (habit, date) actually checked in — "none" is the absence of
/// a row for that date, not a stored level.
model CheckIn {
  id      String       @id @default(cuid())
  habitId String
  habit   Habit        @relation(fields: [habitId], references: [id])
  date    DateTime     @db.Date
  level   CheckInLevel

  @@unique([habitId, date])
  @@index([habitId])
}

enum GoalStatus {
  NOT_STARTED
  IN_PROGRESS
  DONE
}

enum LifeGoalStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

/// An outcome, e.g. "Improve Body Composition" — distinct from a Task
/// (one-off action) and a Habit (recurring behaviour), and NOT the same
/// thing as the `Goal` model below (a Finance savings target — an unrelated
/// concept that happens to share the word "Goal"; this one is named
/// LifeGoal only to dodge that Prisma clash, same reasoning as ActionGoal
/// below). Pillar-scoped like Habit; areaId is optional — a goal can sit
/// directly under a Pillar with no single Area.
model LifeGoal {
  id     String         @id @default(cuid())
  name   String
  status LifeGoalStatus @default(ACTIVE)

  pillarId String
  pillar   Pillar  @relation(fields: [pillarId], references: [id])
  areaId   String?
  area     Area?   @relation(fields: [areaId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks   Task[]
  habits  HabitGoal[]
  systems SystemGoal[]

  @@index([pillarId])
  @@index([areaId])
}

/// Legacy one-off-action model, superseded by Task (see Task's schema
/// comment) — kept only so pre-migration rows aren't orphaned. No app code
/// creates, reads, or writes ActionGoal rows anymore; every row that existed
/// here was copied forward into Task by migration 20260819_tasks_v2_habits_goals.
model ActionGoal {
  id        String     @id @default(cuid())
  areaId    String
  area      Area       @relation(fields: [areaId], references: [id])
  name      String
  status    GoalStatus @default(NOT_STARTED)
  dueDate   DateTime?  @db.Date
  myday     Boolean    @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([areaId])
}

/// One row per (Area, date) log of Pain and Mobility scores (each 0-10).
/// Keyed by area_id + date deliberately, not a fixed Ankylosing-Spondylitis
/// FK, so this extends to other Areas later with no schema change — only
/// Ankylosing Spondylitis is populated at MVP, enforced in the UI layer,
/// not the schema.
model PainMobilityLog {
  id        String   @id @default(cuid())
  areaId    String
  area      Area     @relation(fields: [areaId], references: [id])
  date      DateTime @db.Date
  pain      Int
  mobility  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([areaId, date])
  @@index([areaId])
}

enum HeadacheLevel {
  NONE
  MILD
  MODERATE
  BAD
}

/// One cross-cutting entry per date (no Area scoping — unlike PainMobilityLog,
/// which stays untouched as a separate, Area-scoped, 0-10-scale table; see
/// docs/adr/0007-v2-phase3-daily-log-sheet.md). 1-5 is the only scale this
/// model ever stores. stiffness stores the bucket's representative midpoint
/// (7/22/45/75), never the raw bucket selection — the bucket is a UI-only
/// concept. headache stores the day's worst value reached so far (see
/// lib/daily-log's day's-worst logic — a lower tap later in the day is a
/// no-op, enforced above the schema, not by a DB constraint). mobility/
/// trained are deliberately NOT columns here — they're derived at read time
/// from that day's check-ins on the two seeded habits in
/// lib/daily-log/habit-seed.ts (see lib/daily-log/data.ts), never
/// persisted, so they can never go stale relative to the CheckIn rows they
/// come from.
model DailyLog {
  id           String        @id @default(cuid())
  date         DateTime      @unique @db.Date
  mood         Int
  stress       Int
  energy       Int
  sleepQuality Int
  pain         Int
  headache     HeadacheLevel
  stiffness    Int
  weight       Float?
  waist        Float?
  bpSystolic   Int?
  bpDiastolic  Int?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

enum SystemType {
  PROCESS
  EXPERIMENT
}

/// An Experiment run's verdict at its review date — Continue/Escalate/Stop
/// (DATA_MODEL.md §5). Process runs use runOutcome (a plain note) instead;
/// a Process's "mark concluded" isn't forced into this continue/escalate/
/// stop framing.
enum SystemVerdict {
  CONTINUE
  ESCALATE
  STOP
}

/// Paused reads as "deliberately dormant, not failing" per DATA_MODEL.md —
/// excluded from nudges/streak pressure by every reader that iterates
/// Systems. Archived Systems are hidden behind a "Show archived" toggle,
/// never deleted (see docs/adr/0008-v2-phase4-systems.md).
enum SystemState {
  ACTIVE
  PAUSED
  DRAFT
  ARCHIVED
}

/// Fixed set of five (DATA_MODEL.md §5) — no generic user-defined field
/// builder, per the handoff's explicit exclusion. SystemStep's type-specific
/// columns are added incrementally, one ticket's worth at a time, as each
/// step type's build lands (see docs/adr/0008-v2-phase4-systems.md).
enum SystemStepType {
  CHECKLIST
  CHECKPOINT
  MILESTONE
  MEASURE
  REPEATING
}

/// A Repeating step's end condition: a fixed occurrence count, or tied to
/// its System's Experiment review date (DATA_MODEL.md §5).
enum SystemStepEndCondition {
  FIXED_COUNT
  REVIEW_DATE
}

/// The core entity (DATA_MODEL.md §5): a named Process or Experiment. scope
/// is real FKs — pillarId required, areaId nullable (null = pillar-level,
/// e.g. Finances' own "Payday routine") — mirroring Habit/Task's existing
/// shape rather than the prototype's string `scope`. A run is a System row
/// with templateId set; its steps are copied (not referenced) from the
/// template at creation time (see SystemStep). reviewOffsetDays/review are
/// mutually exclusive at the template level (relative vs absolute review
/// date, enforced in lib/systems/actions.ts) — a run always gets a
/// concrete stamped `review`. parentId nesting is capped at one level,
/// enforced in lib/systems/actions.ts, not the schema.
model System {
  id       String  @id @default(cuid())
  name     String
  pillarId String
  pillar   Pillar  @relation(fields: [pillarId], references: [id])
  areaId   String?
  area     Area?   @relation(fields: [areaId], references: [id])

  type  SystemType
  state SystemState @default(ACTIVE)

  body      String?
  reference String?

  /// Experiment only. Absolute review date; mutually exclusive with
  /// reviewOffsetDays at the template level (enforced in actions.ts).
  review DateTime? @db.Date
  /// Experiment template only: "N days after this run's start" — resolved
  /// to a concrete `review` on each run at creation time.
  reviewOffsetDays Int?
  /// Experiment only, required at creation (enforced in actions.ts).
  criteria String?

  sequential Boolean @default(false)

  isTemplate Boolean @default(false)
  runNoun    String?
  templateId String?
  template   System?  @relation("SystemRuns", fields: [templateId], references: [id])
  runs       System[] @relation("SystemRuns")

  /// Run-only summary fields, populated when a run concludes — stored
  /// rather than re-derived from step detail each time (DATA_MODEL.md §5).
  /// A run's *start* is just its own `createdAt`; no separate column for
  /// that would only duplicate it.
  runEnd       DateTime?
  runStepsDone Int?
  /// Process: the optional outcome note on "mark concluded". Experiment:
  /// the optional written outcome alongside `verdict`.
  runOutcome String?
  /// Experiment only — the average of the run's own Checkpoint ratings,
  /// snapshotted at conclusion for the cross-run rating overlay.
  runRating Float?
  /// Experiment only, set together with runEnd/runOutcome via the
  /// Set-verdict action once `today >= review`.
  verdict SystemVerdict?

  parentId String?
  parent   System?  @relation("SystemNesting", fields: [parentId], references: [id])
  children System[] @relation("SystemNesting")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  steps       SystemStep[]
  decisions   SystemDecision[]
  habits      SystemHabit[]
  goals       SystemGoal[]
  evaluations SystemEvaluation[]

  @@index([pillarId])
  @@index([areaId])
  @@index([templateId])
  @@index([parentId])
}

/// A dated "how is this actually going, right now" log entry, independent
/// of a Process's runOutcome/runEnd or an Experiment's verdict — both of
/// those are end-of-run judgments, this is an ongoing signal loggable at
/// any time on a System in any state (docs/adr/0011-v2-phase6-insights.md
/// §"System evaluation"). Three required 1-5 ratings, never blended into
/// one stored score — the overall score is always computed at read time
/// (lib/systems/evaluation.ts) from the three, so a UI change to how the
/// average is presented never requires a backfill.
model SystemEvaluation {
  id       String   @id @default(cuid())
  systemId String
  system   System   @relation(fields: [systemId], references: [id], onDelete: Cascade)
  date     DateTime @db.Date

  effectiveness  Int
  consistency    Int
  sustainability Int
  note           String?

  createdAt DateTime @default(now())

  @@index([systemId])
}

/// One polymorphic table for all five step types (DATA_MODEL.md §5) —
/// matches Habit/Task's existing shape (one table, nullable columns for
/// what doesn't apply to every row) rather than five parallel models.
/// doneOn holds the (possibly backdated) completion date; ticking stamps
/// today, a "Not today?" picker corrects it after (see lib/systems/logic.ts).
model SystemStep {
  id        String         @id @default(cuid())
  systemId  String
  system    System         @relation(fields: [systemId], references: [id], onDelete: Cascade)
  type      SystemStepType
  text      String
  done      Boolean        @default(false)
  doneOn    DateTime?
  sortOrder Int            @default(0)

  /// Checkpoint only. Captured through the tick-then-prompt flow — ticking
  /// never blocks on these, they're always optional and skippable.
  targetDate DateTime? @db.Date
  rating     Int?
  comment    String?
  /// A Vercel Blob CDN URL — no binary data in Postgres. Deleting this
  /// step deletes the Blob object too (see lib/systems/actions.ts).
  photoUrl   String?

  /// Dated milestone only.
  date DateTime? @db.Date

  /// Measure only. Steps sharing the same metricName form one series
  /// (DATA_MODEL.md §5) — a plain user-entered label, not a picker.
  value      Float?
  unit       String?
  target     Float?
  metricName String?

  /// Repeating only. Expected occurrence dates are computed on the fly
  /// from cadenceDays + createdAt (the anchor) — never materialized as
  /// rows, same idiom as the Phase 1 habit schedule engine. Actual
  /// completions are logged in SystemStepOccurrence.
  cadenceDays    Int?
  endCondition   SystemStepEndCondition?
  /// FIXED_COUNT only — the target number of occurrences.
  endValue       Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  occurrences SystemStepOccurrence[]

  @@index([systemId])
}

/// Actual completions of a Repeating step — the "occurrence log", mirroring
/// Habit/CheckIn's definition-row/log-rows split. Backdatable the same way
/// as any other step (see resolveBackdate).
model SystemStepOccurrence {
  id         String     @id @default(cuid())
  stepId     String
  step       SystemStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  occurredOn DateTime   @db.Date
  loggedAt   DateTime   @default(now())

  @@index([stepId])
}

/// Many-to-many System<->Habit, mirroring HabitGoal's join-table shape.
/// A System declares the Habits it serves; there is no reverse
/// Habit-side linkage beyond this table (DATA_MODEL.md §5).
model SystemHabit {
  systemId String
  system   System @relation(fields: [systemId], references: [id], onDelete: Cascade)
  habitId  String
  habit    Habit  @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@id([systemId, habitId])
  @@index([habitId])
}

/// Many-to-many System<->LifeGoal, mirroring HabitGoal's join-table shape.
model SystemGoal {
  systemId String
  system   System   @relation(fields: [systemId], references: [id], onDelete: Cascade)
  goalId   String
  goal     LifeGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@id([systemId, goalId])
  @@index([goalId])
}

/// Dated decision-log entries, separate from System.body — "why did I
/// change this" stays answerable months later (DATA_MODEL.md §5).
model SystemDecision {
  id       String   @id @default(cuid())
  systemId String
  system   System   @relation(fields: [systemId], references: [id], onDelete: Cascade)
  when     DateTime @default(now())
  body     String

  @@index([systemId])
}

enum AccountType {
  ASSET
  LIABILITY
}

enum AccountKind {
  /// Holds an itemised Transaction ledger (parsed statement uploads add to
  /// it) — a bank current account, a credit card.
  TRANSACTIONAL
  /// Balance-only — statement uploads (or manual entry) add dated
  /// Snapshots with no itemised transaction list expected, e.g. a pension.
  VALUATION
}

/// A Finance asset or liability, renamed/reshaped from v1's Item per
/// ADR-0005/ADR-0010. Its value now lives on dated Snapshot rows, not a
/// single overwritten column, so balance history is visible over time.
/// accessible marks instant-access cash (drives the emergency-fund runway
/// calc); excluded marks e.g. a pension — tracked and shown, but dropped
/// from the accessible net-worth figure. cls is free text the user sets
/// themselves, not a fixed category enum — "Net worth by class" groups by
/// whatever the user calls it. manualOnly marks an account with no
/// statement-upload path (Snapshots are still entered by hand). active:
/// false hides an account without deleting its Snapshot history.
model Account {
  id           String        @id @default(cuid())
  name         String
  type         AccountType
  kind         AccountKind   @default(VALUATION)
  cls          String?
  accessible   Boolean       @default(false)
  excluded     Boolean       @default(false)
  manualOnly   Boolean       @default(false)
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  snapshots    Snapshot[]
  transactions Transaction[]
  statements   Statement[]
}

/// A dated balance record for an Account — replaces v1's single
/// Item.value column, so an account's value comes from its own history,
/// not one number overwritten in place. statementId (nullable) links back
/// to the upload event that produced this Snapshot, when there was one —
/// a manually entered Snapshot has none (#148, ADR-0015; sourceFileUrl
/// lived here before that ticket, see Statement below for where it moved).
/// confidence is set only by Valuation statement-upload parsing (#116,
/// ADR-0010) — null for a manually entered or Transactional-derived
/// Snapshot, which are never held for review (lib/finance/logic.ts's
/// isHeldForReview treats null as "not held").
model Snapshot {
  id          String     @id @default(cuid())
  accountId   String
  account     Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  date        DateTime   @db.Date
  balance     Decimal    @db.Decimal(12, 2)
  confidence  Float?
  createdAt   DateTime   @default(now())
  statementId String?
  statement   Statement? @relation(fields: [statementId], references: [id])

  @@index([accountId, date])
  @@index([statementId])
}

/// One uploaded bank/card statement — the record of the upload event
/// itself, distinct from the Snapshot (balance) and Transactions (line
/// items) it produces (#148, ADR-0015). `name` is generated
/// (`{institutionName} — {account name} — {month YYYY}`, falling back to
/// `{account name} — Statement {uploadedAt}` when extraction can't
/// determine institution/period confidently) and user-editable afterward.
/// sourceFileUrl lived on Snapshot before this — moved here since it's a
/// property of the upload/document, not of the balance point it produced
/// (a manual balance edit has no source file at all).
model Statement {
  id               String        @id @default(cuid())
  accountId        String
  account          Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name             String
  institutionName  String?
  periodStart      DateTime?     @db.Date
  periodEnd        DateTime?     @db.Date
  sourceFileUrl    String
  originalFilename String?
  uploadedAt       DateTime      @default(now())
  snapshots        Snapshot[]
  transactions     Transaction[]

  @@index([accountId])
}

enum ReceivableStatus {
  OPEN
  SETTLED
}

/// Money owed to the user (e.g. a loan to a friend) — a third item type
/// alongside Account's asset/liability, tracked distinctly so it's never
/// mistaken for real spend or income. Converting cash to a Receivable
/// (and settling it) causes no net-worth change (ADR-0010). Schema only
/// in this ticket — the "this became a receivable" review action and
/// settle flow (and Transaction's receivableId link) are #114.
model Receivable {
  id           String           @id @default(cuid())
  amount       Decimal          @db.Decimal(12, 2)
  status       ReceivableStatus @default(OPEN)
  note         String?
  openedAt     DateTime         @default(now())
  settledAt    DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  transactions Transaction[]
}

/// Links two Transactions (one OUT, one IN, on two different Accounts) as
/// the same money moving between the user's own accounts — a third
/// reclassification alongside Receivable and GoalContribution, excluded
/// from spend/income totals the same way (#138, ADR-0013). No amount/date
/// of its own: both already live on the two linked Transactions, and a
/// stored copy would just be one more thing that could drift from them.
/// No OPEN/SETTLED lifecycle either, unlike Receivable — both sides
/// already exist by the time a user links them.
model Transfer {
  id           String        @id @default(cuid())
  note         String?
  createdAt    DateTime      @default(now())
  transactions Transaction[]
}

/// Singleton: the fixed monthly income/outgoings summary, distinct from the
/// dated Transactions ledger (a later ticket). id is always BASELINE_ID.
model Baseline {
  id             String   @id
  monthlyIncome  Decimal  @default(0) @db.Decimal(12, 2)
  fixedOutgoings Decimal  @default(0) @db.Decimal(12, 2)
  updatedAt      DateTime @updatedAt
}

/// A standing monthly spending limit for one Transaction category (#123,
/// ADR-0010) — category, not Account/cls, since Transactions are already
/// categorised and that's the natural fit for "how much do I spend on
/// Food a month." Not month-scoped itself (no rollover, per the AC) —
/// one row per category, read fresh against each month's actual spend
/// (lib/finance/category-breakdown.ts's budgetVsActual).
model Budget {
  id        String   @id @default(cuid())
  category  String   @unique
  limit     Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum GoalVehicle {
  EMERGENCY_FUND
  LISA
  PENSION
  STOCKS_ISA
  CASH_ISA
  GENERIC
}

/// A savings target (Emergency Fund, LISA, ...) — distinct from the
/// Finances North Star, which is the single headline target below.
/// vehicle is a label only (ADR-0010) — no LISA cap/bonus or ISA
/// allowance is modeled. priority is an explicit, user-editable rank,
/// not implied by vehicle — the user's real priority order can change
/// independently of which vehicle a Goal uses. `saved` is NOT a column
/// here (#120, ADR-0010) — it's the computed sum of this Goal's
/// GoalContribution rows (lib/finance/data.ts's getGoals()), same
/// "value lives in dated child rows" shape as Account/Snapshot.
/// monthlyContribution is the stated-plan figure, independent of and
/// allowed to diverge from the actual contribution log.
model Goal {
  id                  String             @id @default(cuid())
  name                String
  target              Decimal            @db.Decimal(12, 2)
  monthlyContribution Decimal            @db.Decimal(12, 2)
  vehicle             GoalVehicle        @default(GENERIC)
  priority            Int                @default(0)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  contributions       GoalContribution[]
}

/// A dated, per-goal contribution log entry — the source of truth for
/// Goal.saved (computed as this table's sum), replacing a manually
/// overwritten column (#120, ADR-0010). Optionally linked back to the
/// Transaction that funded it via Transaction.goalContributionId
/// (mirroring Receivable's own link exactly) — a contribution can also
/// stand alone with no linked transaction (e.g. cash saved outside any
/// tracked account).
model GoalContribution {
  id           String        @id @default(cuid())
  goalId       String
  goal         Goal          @relation(fields: [goalId], references: [id], onDelete: Cascade)
  date         DateTime      @db.Date
  amount       Decimal       @db.Decimal(12, 2)
  note         String?
  createdAt    DateTime      @default(now())
  transactions Transaction[]

  @@index([goalId])
}

/// Singleton: the single headline Finances target + deadline, tracked
/// against accessible net worth. Both fields nullable — optional, not
/// mandatory upfront, same as a Pillar/Area's North Star. id is always
/// FINANCE_NORTH_STAR_ID.
model FinanceNorthStar {
  id        String    @id
  target    Decimal?  @db.Decimal(12, 2)
  deadline  DateTime? @db.Date
  updatedAt DateTime  @updatedAt
}

enum TransactionDirection {
  IN
  OUT
}

/// A Transaction's spending category (ADR-0015, hierarchy added #173) — a
/// fixed, system-managed two-level hierarchy (parentId null = top-level
/// "Housing"/"Food"/etc., parentId set = a subcategory like "Groceries"
/// under "Food"), not free text and no longer user-editable from Settings
/// (that screen is read-only, #175) — the earlier flat, user-editable
/// version fragmented into ~40 near-duplicate categories, which is why
/// the hierarchy is fixed rather than another freeform list. A
/// Transaction always references a leaf subcategory, never a top-level
/// category directly — enforced at the app layer (the categorizer only
/// ever resolves to a leaf, #174), not by a DB constraint, since Postgres
/// check constraints can't reference other rows of the same table. Unique
/// per parent (not globally) so two different parents can each have a
/// same-named child without colliding; a separate partial unique index
/// (see migration SQL) keeps top-level names unique among themselves.
/// parentId's FK is ON DELETE CASCADE rather than this codebase's usual
/// optional-relation default of SET NULL — deliberately: a parentId:null
/// row left behind by SET NULL would silently look like a new top-level
/// category instead of an orphaned subcategory. Cascading is safe only
/// because the taxonomy is fixed/system-managed — a top-level category is
/// never deleted except by a migration revising its children in the same
/// breath (see ADR-0015's #173 addendum). Unrelated to Pillar despite the
/// shared word "Category" — see CONTEXT.md's Pillar entry.
model Category {
  id           String        @id @default(cuid())
  name         String
  parentId     String?
  parent       Category?     @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children     Category[]    @relation("CategoryHierarchy")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]

  @@unique([parentId, name])
  @@index([parentId])
}

/// A dated, categorized ledger entry — distinct from Baseline's fixed
/// monthly summary. accountId replaces v1's linkedItemId placeholder
/// (nothing ever populated it) with a real FK, per ADR-0010. receivableId
/// is set by the "this became a receivable" reclassification action
/// (#114, ADR-0010) — not unique, since the same Receivable can be
/// referenced by both the funding OUT transaction and an optional
/// repayment IN transaction. goalContributionId is the mirrored "this
/// went toward Goal X" reclassification (#120, ADR-0010), same shape.
/// A transaction can carry at most ONE of the two (never both) — enforced
/// by lib/finance/logic.ts's canReclassifyTransaction, and atomically at
/// write time by only ever claiming a transaction where both are still
/// null (lib/finance/actions.ts's claimTransaction). A transaction with
/// either set is excluded from spend totals (lib/finance/category-
/// breakdown.ts) since it's a loan or a goal contribution, not real
/// spend/income — cash flow (lib/finance/cash-flow-trend.ts) stays
/// reclassification-unaware since real cash still moved. confidence is
/// set only by statement-upload parsing (#115, ADR-0010) — null for
/// manually entered transactions, which are never held for review (see
/// lib/finance/logic.ts's isHeldForReview). categoryId replaced the
/// original free-text `category` column (ADR-0015) — see Category above.
model Transaction {
  id                 String               @id @default(cuid())
  date               DateTime             @db.Date
  amount             Decimal              @db.Decimal(12, 2)
  direction          TransactionDirection
  categoryId         String
  category           Category             @relation(fields: [categoryId], references: [id])
  source             String?
  accountId          String?
  account            Account?             @relation(fields: [accountId], references: [id])
  receivableId       String?
  receivable         Receivable?          @relation(fields: [receivableId], references: [id])
  goalContributionId String?
  goalContribution   GoalContribution?    @relation(fields: [goalContributionId], references: [id])
  transferId         String?
  transfer           Transfer?            @relation(fields: [transferId], references: [id])
  confidence         Float?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  statementId        String?
  statement          Statement?           @relation(fields: [statementId], references: [id])

  @@index([date])
  @@index([categoryId])
  @@index([accountId])
  @@index([receivableId])
  @@index([goalContributionId])
  @@index([transferId])
  @@index([statementId])
}

/// A live Enable Banking authorization — the result of one `POST /sessions`
/// call, tied to one ASPSP (bank). accounts is stored as raw JSON (an array
/// of {uid, ...}) rather than a separate table: Enable Banking's exact
/// per-account field shape beyond `uid` isn't fully confirmed yet (see
/// docs/research/enable-banking-api.md), and storing the raw response keeps
/// us from losing data to an over-narrow schema while that's still settling.
model EnableBankingLink {
  id           String   @id @default(cuid())
  aspspName    String
  aspspCountry String
  sessionId    String   @unique
  accounts     Json
  validUntil   DateTime
  createdAt    DateTime @default(now())
}

/// A dated, free-text journal entry, cross-cutting rather than owned by one
/// feature — pillarId/areaId are both optional and mutually exclusive in
/// practice (the UI offers one tag, not both): an untagged entry is a
/// general note, not an error.
model Thought {
  id        String   @id @default(cuid())
  text      String
  date      DateTime @db.Date
  pillarId  String?
  pillar    Pillar?  @relation(fields: [pillarId], references: [id])
  areaId    String?
  area      Area?    @relation(fields: [areaId], references: [id])
  createdAt DateTime @default(now())

  @@index([pillarId])
  @@index([areaId])
}

/// A practical task grouping (e.g. "Work", "Groceries") — distinct from a
/// Pillar (area of life) and a Tag (flexible metadata). Deleting a list
/// nulls out `listId` on its tasks (see Task.list's onDelete) rather than
/// destroying them; archiving is the softer "stop using, keep the tasks
/// labeled" alternative to deleting one outright.
model TaskList {
  id         String    @id @default(cuid())
  name       String
  color      String?
  sortOrder  Int       @default(0)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  tasks      Task[]
}

/// Lightweight, freeform metadata — created on first use from the task
/// composer's tag input rather than managed on a separate admin screen.
model TaskTag {
  id        String          @id @default(cuid())
  name      String          @unique
  createdAt DateTime        @default(now())
  tasks     TaskTagOnTask[]
}

model TaskTagOnTask {
  taskId String
  task   Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tagId  String
  tag    TaskTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
  @@index([tagId])
}

enum TaskStatus {
  ACTIVE
  COMPLETED
}

enum TaskReminderOffset {
  AT_DUE
  MIN_15_BEFORE
  HOUR_1_BEFORE
  DAY_1_BEFORE
  CUSTOM
}

enum TaskRepeatRule {
  DAILY
  WEEKDAYS
  SELECTED_WEEKDAYS
  WEEKLY
  EVERY_N_DAYS
  EVERY_N_WEEKS
  EVERY_N_MONTHS
  MONTHLY
  CUSTOM
}

/// The Task lifecycle is three independent nullable timestamps rather than a
/// pile of booleans: completedAt/archivedAt/deletedAt can't contradict each
/// other because callers only ever set one at a time, and each is
/// independently meaningful for history (e.g. a task can be both completed
/// *and* later archived, keeping both timestamps). Query-time precedence is
/// deletedAt > archivedAt > completedAt > active, enforced in lib/tasks, not
/// the schema. dueDate is @db.Date (UTC midnight) matching the rest of the
/// app's convention; dueTime is a separate "HH:mm" string rather than
/// folding time into dueDate, so a date-only task never has to fake a time
/// component. This is also the single one-off-action model for the whole
/// app — areaId/pillarId cover what ActionGoal used to (see its schema
/// comment); goalId is new. sortOrder is this task's position within its
/// List — independent from MyDayEntry.sortOrder, its position within a
/// day's My Day, since dragging a Work task to the top of today shouldn't
/// reorder the Work List itself.
model Task {
  id        String     @id @default(cuid())
  title     String
  notes     String?
  status    TaskStatus @default(ACTIVE)
  important Boolean    @default(false)
  sortOrder Int        @default(0)

  listId String?
  list   TaskList? @relation(fields: [listId], references: [id], onDelete: SetNull)

  pillarId String?
  pillar   Pillar?   @relation(fields: [pillarId], references: [id], onDelete: SetNull)
  areaId   String?
  area     Area?     @relation(fields: [areaId], references: [id], onDelete: SetNull)
  goalId   String?
  goal     LifeGoal? @relation(fields: [goalId], references: [id], onDelete: SetNull)

  dueDate DateTime? @db.Date
  dueTime String?

  reminderOffset  TaskReminderOffset?
  repeatRule      TaskRepeatRule?
  repeatWeekdays  Int[]            @default([])
  repeatIntervalN Int?

  completedAt DateTime?
  archivedAt  DateTime?
  deletedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tags         TaskTagOnTask[]
  myDayEntries MyDayEntry[]
  steps        TaskStep[]

  @@index([listId])
  @@index([pillarId])
  @@index([areaId])
  @@index([goalId])
  @@index([dueDate])
  @@index([status])
}

/// One row per (task, date) it was part of My Day — never a boolean reset
/// each morning, so which tasks were planned on any past date stays
/// reconstructable. A task can appear in My Day either via a row here
/// (manually added) or because its dueDate is that date (automatic); see
/// lib/tasks/data.ts for how the two are combined. sortOrder here is
/// independent of Task.sortOrder — see Task's schema comment.
model MyDayEntry {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  sortOrder Int      @default(0)
  addedAt   DateTime @default(now())

  @@unique([taskId, date])
  @@index([date])
}

/// A lightweight sub-item within a Task ("Book holiday" -> "Check flights").
/// Completing every Step does not complete the parent Task — that's a
/// deliberate choice, not an oversight (see the Steps section of the spec
/// this shipped against): a Task's own completion stays an explicit action.
model TaskStep {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title     String
  completed Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([taskId])
}

enum NudgeType {
  HABIT_DUE
  TASK_OVERDUE
  STREAK_AT_RISK
  WEEKLY_REVIEW_READY
  METRIC_OFF_TARGET
  MORNING_BRIEF
  /// An Active Experiment (template, standalone, or an actual run) whose
  /// review date has arrived with no verdict recorded yet — see #109/#111
  /// and docs/adr/0009-systems-review-nudges.md.
  SYSTEM_REVIEW_DUE
  /// A leaf category's current-month spend running notably above its own
  /// trailing-3-month baseline (ADR-0012's spend-deviation math) — see
  /// #179 and ADR-0015's #173 addendum.
  CATEGORY_SPEND_ANOMALY
}

enum NudgeTargetType {
  HABIT
  TASK
  /// The eligible System's own id (a run's own id, not its template's —
  /// see docs/adr/0009-systems-review-nudges.md for why the displayed
  /// link still resolves to the template's card).
  SYSTEM
  NONE
}

/// A delivered notification record — see docs/adr/0002-nudges-delivery-rules.md
/// and lib/nudges/eligibility.ts, which is the actual source of truth for
/// when/whether one of these gets created. `dedupKey` is what makes the
/// scheduled job idempotent and enforces "one per habit per day, highest
/// severity wins": each eligible trigger computes the same key on every
/// run (e.g. `habit:<id>:<date>`), so a rerun either no-ops (same/lower
/// severity already stored) or upgrades the existing row in place (higher
/// severity superseding a lower one) rather than inserting a duplicate.
/// `severity` is stored (not just derived from `type`) so dedup/upgrade
/// comparisons don't need a second lookup table at read time. Read state
/// changes only via "Mark all read" or acting on a card — never by
/// opening the page (see the ADR) — so `readAt` is set explicitly by
/// lib/nudges/actions.ts, not by any page-view side effect.
model Nudge {
  id           String          @id @default(cuid())
  dedupKey     String          @unique
  type         NudgeType
  severity     Int
  targetType   NudgeTargetType @default(NONE)
  targetId     String?
  title        String
  body         String
  createdAt    DateTime        @default(now())
  readAt       DateTime?
  snoozedUntil DateTime?

  @@index([readAt])
  @@index([snoozedUntil])
}

/// Singleton session state for the Weekly review's 5-step flow (#80) —
/// same idempotent-singleton pattern as AppSettings: seeded by its own
/// migration's INSERT ... ON CONFLICT DO NOTHING rather than upserted on
/// read, so concurrent first-reads (e.g. parallel static prerendering)
/// never race to insert it themselves. Exists so the flow is resumable
/// across visits — closing the tab mid-review and coming back later
/// picks up at the same step with the same draft/verdicts/order, rather
/// than losing progress. `verdicts` maps habitId -> "KEEP" | "PAUSE" |
/// "REWORK" (Json rather than a join table — it's read/written as one
/// blob per step, never queried per-habit). `rankOrder` is Step 3's
/// drag-reordered Task ids, oldest-first; the top 3 become next week's
/// My Day defaults on Finish.
model WeeklyReviewSession {
  id          String   @id
  step        Int      @default(0)
  draftDigest String?
  verdicts    Json     @default("{}")
  rankOrder   String[] @default([])
  startedAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// One chart or table type a Visual can be (#161, ADR-0017).
enum VisualType {
  LINE
  BAR
  PROGRESS_BAR
  SCATTER
  STREAK_HEATMAP
  TABLE
}

enum TableColumnType {
  TEXT
  NUMBER
  DATE
  CHECKBOX
}

/// One chart or table instance placed in a Pillar/Area page's Charts or
/// Table zone (#161, ADR-0017/#162) — see CONTEXT.md's "Visual" entry.
/// Unlike the six singular Page sections (North Star, Goals, ...), Charts
/// and Table are zones that can each hold any number of Visuals, so this
/// has its own pillarId/areaId scoping rather than being addressed by
/// SectionType alone. `config` holds type-specific settings: a Progress
/// bar's ad-hoc target, a chart's source binding
/// (`{binding: {adapter, refId}} | null`, or `{xBinding, yBinding}` for
/// Scatter), a bound Table's adapter name. No
/// `config` shape is enforced at the schema level, same as
/// WeeklyReviewSession.verdicts/AppSettings-style Json fields elsewhere.
model Visual {
  id        String     @id @default(cuid())
  pillarId  String
  pillar    Pillar     @relation(fields: [pillarId], references: [id])
  areaId    String?
  area      Area?      @relation(fields: [areaId], references: [id])
  type      VisualType
  title     String
  config    Json       @default("{}")
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  columns TableColumn[]
  rows    TableRow[]
  records VisualRecord[]

  @@index([pillarId])
  @@index([areaId])
}

/// Ad-hoc chart data points (#161) — only exist for a Visual with no
/// source binding in its config; a bound chart always has zero of these,
/// resolved live from its adapter instead. Which fields a chart type reads
/// varies: Line/Bar/Streak heatmap use date+yValue; Scatter uses
/// xValue+yValue; Progress bar reads only the latest record's yValue.
model VisualRecord {
  id        String    @id @default(cuid())
  visualId  String
  visual    Visual    @relation(fields: [visualId], references: [id], onDelete: Cascade)
  date      DateTime? @db.Date
  xValue    Float?
  yValue    Float?
  xLabel    String?
  note      String?
  createdAt DateTime  @default(now())

  @@index([visualId])
}

/// A Table Visual's user-added custom column (#161) — a bound table's
/// built-in columns (e.g. Goals' Name/Status/Progress%) are never stored
/// here, they're declared by the adapter and resolved at render time.
model TableColumn {
  id        String          @id @default(cuid())
  visualId  String
  visual    Visual          @relation(fields: [visualId], references: [id], onDelete: Cascade)
  name      String
  type      TableColumnType
  sortOrder Int             @default(0)

  @@index([visualId])
}

/// One row of a Table Visual (#161). For a freeform table, every row is a
/// real TableRow. For a bound table, a row is synthesized at render time
/// from the adapter's live entity list (boundEntityId null in that
/// synthesized case) — a real TableRow only gets created once the user
/// enters a value into a custom column for that entity, at which point
/// boundEntityId links it back. `data` is keyed by TableColumn id.
model TableRow {
  id            String   @id @default(cuid())
  visualId      String
  visual        Visual   @relation(fields: [visualId], references: [id], onDelete: Cascade)
  boundEntityId String?
  data          Json     @default("{}")
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([visualId])
  /// Postgres treats multiple NULLs as distinct under a unique index, so
  /// this only actually constrains bound rows (boundEntityId non-null) —
  /// any number of freeform rows (boundEntityId null) coexist fine. Closes
  /// a race in updateTableCell's lazy-create-on-first-edit path (#169):
  /// two concurrent first edits for the same bound entity could otherwise
  /// each pass a pre-check and create a duplicate TableRow.
  @@unique([visualId, boundEntityId])
}
