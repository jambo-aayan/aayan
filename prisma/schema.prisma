generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Session {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  expiresAt DateTime
}

/// Singleton tracking failed login attempts against the single shared app
/// password, for the rate-limit lockout (see lib/auth/rate-limit.ts and
/// ADR-0004). id is always LOGIN_LOCKOUT_ID. failedCount resets to 0 on any
/// successful login.
model LoginLockout {
  id          String    @id
  failedCount Int       @default(0)
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
}

/// A top-level life domain (Health, Finances, ...). id is a stable slug,
/// not a cuid, so seeding can upsert by a human-readable, idempotent key.
/// color propagates to every Area/Goal/Habit/Task under it (see lib/colors.ts)
/// — a subtle accent, never a strongly saturated fill.
model Pillar {
  id        String     @id
  name      String
  color     String?
  northStar String?
  /// Shown on the Pillars card per the handoff — not user-editable (per
  /// #49's grilling Q13/#58 scope, a new Pillar is just its row + accent
  /// color, no description-authoring flow).
  desc      String?
  /// A percentage (independent per Pillar, no enforced sum-to-100 — see
  /// #49's grilling Q13). Feeds Insights' Attention Balance module (#63).
  intendedTimeShare Int?
  areas     Area[]
  thoughts  Thought[]
  tasks     Task[]
  goals     LifeGoal[]
  habits    Habit[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

/// A sub-topic within a Pillar (e.g. Sleep within Health). id is a stable
/// slug for the same idempotent-seeding reason as Pillar.id.
model Area {
  id               String            @id
  pillarId         String
  pillar           Pillar            @relation(fields: [pillarId], references: [id])
  name             String
  currentState     String?
  northStar        String?
  sortOrder        Int
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  habits           Habit[]
  /// Legacy one-off-action records, superseded by Task.areaId — kept only so
  /// existing rows aren't orphaned; no app code writes here anymore (see
  /// Task's schema comment for where this data actually lives now).
  actionGoals      ActionGoal[]
  goals            LifeGoal[]
  tasks            Task[]
  painMobilityLogs PainMobilityLog[]
  thoughts         Thought[]

  @@index([pillarId])
}

/// Kept only as the historical record of what `frequency` used to mean —
/// still stored on old CheckIn-adjacent code paths' types, but Habit itself
/// now uses the richer `scheduleType` below.
enum HabitFrequency {
  DAILY
  WEEKLY
}

enum CheckInLevel {
  FULL
  MINIMUM
}

/// New Habits default to PAUSED — opt-in, not opt-out (the same principle
/// the old `active: false` default encoded).
enum HabitStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

/// DAILY/WEEKDAYS/WEEKLY/EVERY_N_DAYS/EVERY_N_WEEKS/MONTHLY don't need every
/// field below — see lib/habits/schedule.ts's isScheduledForDate for which
/// fields each type actually reads. CUSTOM stores only scheduleCustomText
/// and never auto-generates an occurrence (same documented limitation as
/// Task.repeatRule's CUSTOM — see lib/tasks/recurrence.ts).
enum HabitScheduleType {
  DAILY
  WEEKDAYS
  SELECTED_WEEKDAYS
  WEEKLY
  EVERY_N_DAYS
  EVERY_N_WEEKS
  MONTHLY
  CUSTOM
}

/// A recurring behaviour. Restricted to one Pillar (areaId is the optional
/// "primary Area" within it); Goal links live in HabitGoal, not here, since
/// a Habit can support several Goals within its Pillar. There is no separate
/// "Habit occurrence" table — whether a Habit occurs on a given date is
/// computed from its schedule (lib/habits/schedule.ts), and completing an
/// occurrence is exactly the existing CheckIn row for that date. That's the
/// whole "occurrence" concept: computed presence + a completion record,
/// never a duplicated Task.
model Habit {
  id   String @id @default(cuid())
  name String

  pillarId String
  pillar   Pillar  @relation(fields: [pillarId], references: [id])
  areaId   String?
  area     Area?   @relation(fields: [areaId], references: [id])

  status HabitStatus @default(PAUSED)

  scheduleType       HabitScheduleType @default(DAILY)
  scheduleWeekdays   Int[]             @default([])
  scheduleIntervalN  Int?
  scheduleAnchorDate DateTime?         @db.Date
  scheduleCustomText String?

  /// Superseded by scheduleType, kept non-null for old rows' sake until a
  /// future cleanup migration; no app code reads this anymore.
  frequency HabitFrequency @default(DAILY)

  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  checkIns  CheckIn[]
  goals     HabitGoal[]

  @@index([areaId])
  @@index([pillarId])
}

/// Many-to-many Habit<->LifeGoal, with at most one isPrimary=true row per
/// habit (enforced in lib/habits/actions.ts, not the schema — matching the
/// rest of this app's relaxed-constraint style). All linked goals are
/// expected to share the habit's pillarId (enforced the same way).
model HabitGoal {
  habitId   String
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  goalId    String
  goal      LifeGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  isPrimary Boolean  @default(false)

  @@id([habitId, goalId])
  @@index([goalId])
}

/// One row per (habit, date) actually checked in — "none" is the absence of
/// a row for that date, not a stored level.
model CheckIn {
  id      String       @id @default(cuid())
  habitId String
  habit   Habit        @relation(fields: [habitId], references: [id])
  date    DateTime     @db.Date
  level   CheckInLevel

  @@unique([habitId, date])
  @@index([habitId])
}

enum GoalStatus {
  NOT_STARTED
  IN_PROGRESS
  DONE
}

enum LifeGoalStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

/// An outcome, e.g. "Improve Body Composition" — distinct from a Task
/// (one-off action) and a Habit (recurring behaviour), and NOT the same
/// thing as the `Goal` model below (a Finance savings target — an unrelated
/// concept that happens to share the word "Goal"; this one is named
/// LifeGoal only to dodge that Prisma clash, same reasoning as ActionGoal
/// below). Pillar-scoped like Habit; areaId is optional — a goal can sit
/// directly under a Pillar with no single Area.
model LifeGoal {
  id     String         @id @default(cuid())
  name   String
  status LifeGoalStatus @default(ACTIVE)

  pillarId String
  pillar   Pillar  @relation(fields: [pillarId], references: [id])
  areaId   String?
  area     Area?   @relation(fields: [areaId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks  Task[]
  habits HabitGoal[]

  @@index([pillarId])
  @@index([areaId])
}

/// Legacy one-off-action model, superseded by Task (see Task's schema
/// comment) — kept only so pre-migration rows aren't orphaned. No app code
/// creates, reads, or writes ActionGoal rows anymore; every row that existed
/// here was copied forward into Task by migration 20260819_tasks_v2_habits_goals.
model ActionGoal {
  id        String     @id @default(cuid())
  areaId    String
  area      Area       @relation(fields: [areaId], references: [id])
  name      String
  status    GoalStatus @default(NOT_STARTED)
  dueDate   DateTime?  @db.Date
  myday     Boolean    @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([areaId])
}

/// One row per (Area, date) log of Pain and Mobility scores (each 0-10).
/// Keyed by area_id + date deliberately, not a fixed Ankylosing-Spondylitis
/// FK, so this extends to other Areas later with no schema change — only
/// Ankylosing Spondylitis is populated at MVP, enforced in the UI layer,
/// not the schema.
model PainMobilityLog {
  id        String   @id @default(cuid())
  areaId    String
  area      Area     @relation(fields: [areaId], references: [id])
  date      DateTime @db.Date
  pain      Int
  mobility  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([areaId, date])
  @@index([areaId])
}

enum ItemType {
  ASSET
  LIABILITY
}

/// A Finance asset or liability. liquid marks instant-access cash (drives a
/// future emergency-fund runway calc); excluded marks e.g. a pension —
/// tracked and shown, but dropped from the accessible net-worth figure.
model Item {
  id        String   @id @default(cuid())
  name      String
  type      ItemType
  value     Decimal  @db.Decimal(12, 2)
  liquid    Boolean  @default(false)
  excluded  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Singleton: the fixed monthly income/outgoings summary, distinct from the
/// dated Transactions ledger (a later ticket). id is always BASELINE_ID.
model Baseline {
  id             String   @id
  monthlyIncome  Decimal  @default(0) @db.Decimal(12, 2)
  fixedOutgoings Decimal  @default(0) @db.Decimal(12, 2)
  updatedAt      DateTime @updatedAt
}

/// A savings target (Emergency Fund, LISA, ...) — distinct from the
/// Finances North Star, which is the single headline target below.
model Goal {
  id                  String   @id @default(cuid())
  name                String
  target              Decimal  @db.Decimal(12, 2)
  saved               Decimal  @db.Decimal(12, 2)
  monthlyContribution Decimal  @db.Decimal(12, 2)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

/// Singleton: the single headline Finances target + deadline, tracked
/// against accessible net worth. Both fields nullable — optional, not
/// mandatory upfront, same as a Pillar/Area's North Star. id is always
/// FINANCE_NORTH_STAR_ID.
model FinanceNorthStar {
  id        String    @id
  target    Decimal?  @db.Decimal(12, 2)
  deadline  DateTime? @db.Date
  updatedAt DateTime  @updatedAt
}

enum TransactionDirection {
  IN
  OUT
}

/// A dated, categorized ledger entry — distinct from Baseline's fixed
/// monthly summary. linkedItemId is a placeholder for a future
/// linked-account reference (account-linking tickets); nothing populates
/// it yet, and there's no FK relation since that entity doesn't exist yet.
model Transaction {
  id           String               @id @default(cuid())
  date         DateTime             @db.Date
  amount       Decimal              @db.Decimal(12, 2)
  direction    TransactionDirection
  category     String
  source       String?
  linkedItemId String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([date])
}

/// A live Enable Banking authorization — the result of one `POST /sessions`
/// call, tied to one ASPSP (bank). accounts is stored as raw JSON (an array
/// of {uid, ...}) rather than a separate table: Enable Banking's exact
/// per-account field shape beyond `uid` isn't fully confirmed yet (see
/// docs/research/enable-banking-api.md), and storing the raw response keeps
/// us from losing data to an over-narrow schema while that's still settling.
model EnableBankingLink {
  id           String   @id @default(cuid())
  aspspName    String
  aspspCountry String
  sessionId    String   @unique
  accounts     Json
  validUntil   DateTime
  createdAt    DateTime @default(now())
}

/// A dated, free-text journal entry, cross-cutting rather than owned by one
/// feature — pillarId/areaId are both optional and mutually exclusive in
/// practice (the UI offers one tag, not both): an untagged entry is a
/// general note, not an error.
model Thought {
  id        String   @id @default(cuid())
  text      String
  date      DateTime @db.Date
  pillarId  String?
  pillar    Pillar?  @relation(fields: [pillarId], references: [id])
  areaId    String?
  area      Area?    @relation(fields: [areaId], references: [id])
  createdAt DateTime @default(now())

  @@index([pillarId])
  @@index([areaId])
}

/// A practical task grouping (e.g. "Work", "Groceries") — distinct from a
/// Pillar (area of life) and a Tag (flexible metadata). Deleting a list
/// nulls out `listId` on its tasks (see Task.list's onDelete) rather than
/// destroying them; archiving is the softer "stop using, keep the tasks
/// labeled" alternative to deleting one outright.
model TaskList {
  id         String    @id @default(cuid())
  name       String
  color      String?
  sortOrder  Int       @default(0)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  tasks      Task[]
}

/// Lightweight, freeform metadata — created on first use from the task
/// composer's tag input rather than managed on a separate admin screen.
model TaskTag {
  id        String          @id @default(cuid())
  name      String          @unique
  createdAt DateTime        @default(now())
  tasks     TaskTagOnTask[]
}

model TaskTagOnTask {
  taskId String
  task   Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tagId  String
  tag    TaskTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
  @@index([tagId])
}

enum TaskStatus {
  ACTIVE
  COMPLETED
}

enum TaskReminderOffset {
  AT_DUE
  MIN_15_BEFORE
  HOUR_1_BEFORE
  DAY_1_BEFORE
  CUSTOM
}

enum TaskRepeatRule {
  DAILY
  WEEKDAYS
  WEEKLY
  MONTHLY
  CUSTOM
}

/// The Task lifecycle is three independent nullable timestamps rather than a
/// pile of booleans: completedAt/archivedAt/deletedAt can't contradict each
/// other because callers only ever set one at a time, and each is
/// independently meaningful for history (e.g. a task can be both completed
/// *and* later archived, keeping both timestamps). Query-time precedence is
/// deletedAt > archivedAt > completedAt > active, enforced in lib/tasks, not
/// the schema. dueDate is @db.Date (UTC midnight) matching the rest of the
/// app's convention; dueTime is a separate "HH:mm" string rather than
/// folding time into dueDate, so a date-only task never has to fake a time
/// component. This is also the single one-off-action model for the whole
/// app — areaId/pillarId cover what ActionGoal used to (see its schema
/// comment); goalId is new. sortOrder is this task's position within its
/// List — independent from MyDayEntry.sortOrder, its position within a
/// day's My Day, since dragging a Work task to the top of today shouldn't
/// reorder the Work List itself.
model Task {
  id        String     @id @default(cuid())
  title     String
  notes     String?
  status    TaskStatus @default(ACTIVE)
  important Boolean    @default(false)
  sortOrder Int        @default(0)

  listId String?
  list   TaskList? @relation(fields: [listId], references: [id], onDelete: SetNull)

  pillarId String?
  pillar   Pillar?   @relation(fields: [pillarId], references: [id], onDelete: SetNull)
  areaId   String?
  area     Area?     @relation(fields: [areaId], references: [id], onDelete: SetNull)
  goalId   String?
  goal     LifeGoal? @relation(fields: [goalId], references: [id], onDelete: SetNull)

  dueDate DateTime? @db.Date
  dueTime String?

  reminderOffset TaskReminderOffset?
  repeatRule     TaskRepeatRule?

  completedAt DateTime?
  archivedAt  DateTime?
  deletedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tags         TaskTagOnTask[]
  myDayEntries MyDayEntry[]
  steps        TaskStep[]

  @@index([listId])
  @@index([pillarId])
  @@index([areaId])
  @@index([goalId])
  @@index([dueDate])
  @@index([status])
}

/// One row per (task, date) it was part of My Day — never a boolean reset
/// each morning, so which tasks were planned on any past date stays
/// reconstructable. A task can appear in My Day either via a row here
/// (manually added) or because its dueDate is that date (automatic); see
/// lib/tasks/data.ts for how the two are combined. sortOrder here is
/// independent of Task.sortOrder — see Task's schema comment.
model MyDayEntry {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  sortOrder Int      @default(0)
  addedAt   DateTime @default(now())

  @@unique([taskId, date])
  @@index([date])
}

/// A lightweight sub-item within a Task ("Book holiday" -> "Check flights").
/// Completing every Step does not complete the parent Task — that's a
/// deliberate choice, not an oversight (see the Steps section of the spec
/// this shipped against): a Task's own completion stays an explicit action.
model TaskStep {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title     String
  completed Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([taskId])
}
