# Neon Postgres connection string (get from the Neon dashboard).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Base64-encoded bcrypt hash of the shared app password. Base64 avoids "$" in
# the raw hash being mangled by env-var expansion. Generate with:
#   node -e "console.log(Buffer.from(require('bcryptjs').hashSync(process.argv[1], 10)).toString('base64'))" "your-password"
APP_PASSWORD_HASH_B64=""

# Vercel Blob read/write token for System Checkpoint step photo uploads.
# Set automatically once a Blob store is connected to the Vercel project
# (Storage → Create Database → Blob); for local dev, run `vercel env pull
# .env` after connecting it, or copy the token from the dashboard by hand.
BLOB_READ_WRITE_TOKEN=""

# Gemini API key for statement upload parsing (Finances → Statements) —
# get one from https://aistudio.google.com/apikey.
GEMINI_API_KEY=""

# Verifies requests to /api/cron/nudges actually came from Vercel Cron (see
# vercel.json) — Vercel sends this as an `Authorization: Bearer` header
# automatically once the env var is set on the project. Generate any
# random string; optional locally (the route allows unauthenticated
# requests when unset, so `curl` testing doesn't need it).
CRON_SECRET=""
